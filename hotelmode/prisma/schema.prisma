generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  value     String   @id
  label     String
  excelName String?  @map("excel_name")
  price     Decimal  @db.Decimal(10, 2)

  @@map("products")
}

model Entry {
  id     Int     @id @default(autoincrement())
  fs     String
  date   String
  goods  String
  amount Int
  price  Decimal @db.Decimal(10, 2)
  sums   Decimal @db.Decimal(10, 2)

  @@map("entries")
}
